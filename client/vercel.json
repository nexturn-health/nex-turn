{
  "rewrites": [
    {
      "source": "/book-appointment/:hospitalSlug",
      "destination": "/api/seo-booking"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico|robots.txt|sitemap.xml|manifest.webmanifest|index.html|nextsynq.png|nextsynq.svg|nexturn.png|og-image.png|google3458237e26607d67.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}